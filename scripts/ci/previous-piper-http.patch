-/* The service is deliberately loopback-only and redirects are forbidden. */
+/* One request owns its async callback context until HANDLE_CLOSING. All SAPI
+ * callbacks stay on the calling thread; no COM interfaces cross threads. */
+struct http_wait
+{
+    HANDLE event, closed;
+    DWORD error, received;
+};
+
+static void CALLBACK http_status(HINTERNET handle, DWORD_PTR context, DWORD status,
+                                void *info, DWORD size)
+{
+    struct http_wait *wait = (struct http_wait *)context;
+    if (!wait) return;
+    switch (status)
+    {
+    case WINHTTP_CALLBACK_STATUS_REQUEST_ERROR:
+        wait->error = ((WINHTTP_ASYNC_RESULT *)info)->dwError;
+        SetEvent(wait->event);
+        break;
+    case WINHTTP_CALLBACK_STATUS_READ_COMPLETE:
+        wait->received = size;
+        SetEvent(wait->event);
+        break;
+    case WINHTTP_CALLBACK_STATUS_SENDREQUEST_COMPLETE:
+    case WINHTTP_CALLBACK_STATUS_HEADERS_AVAILABLE:
+        SetEvent(wait->event);
+        break;
+    case WINHTTP_CALLBACK_STATUS_HANDLE_CLOSING:
+        SetEvent(wait->closed);
+        break;
+    }
+}
+
+static HRESULT await_http(struct http_wait *wait, ISpTTSEngineSite *site, ULONGLONG deadline)
+{
+    for (;;)
+    {
+        if (ISpTTSEngineSite_GetActions(site) & SPVES_ABORT) return S_FALSE;
+        if (GetTickCount64() >= deadline) return HRESULT_FROM_WIN32(ERROR_WINHTTP_TIMEOUT);
+        if (WaitForSingleObject(wait->event, 50) == WAIT_OBJECT_0)
+            return wait->error ? HRESULT_FROM_WIN32(wait->error) : S_OK;
+    }
+}
